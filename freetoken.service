[Unit]
Description=FreeToken WebUI Service
After=network.target

[Service]
Type=simple
# 设置为 root 用户运行
User=root

# 项目绝对路径（假设你的代码放在 /root/your_project）
WorkingDirectory=/root/fork-gpt-outlook-register

# 启动命令（自动读取同目录下的 .env）
ExecStart=/usr/bin/python3 /root/fork-gpt-outlook-register/start_webui.py --host 0.0.0.0 --port 8765 --no-browser

# 崩溃自动重启
Restart=always
RestartSec=5s

# 环境变量设置
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target